# Load before running terraform:  set -a; source .env; set +a
#
# Variables starting with TF_VAR_ are read by Terraform as inputs:
# TF_VAR_domain fills in `variable "domain"` in variables.tf, and so on.

# API token you created (My Profile -> API Tokens). Used by the Cloudflare provider.
# Example: export CLOUDFLARE_API_TOKEN=cfut_Xy9aBcD3fGh1jKlMnOpQrStUvWxYz0123456789A
export CLOUDFLARE_API_TOKEN=

# Account ID (dashboard -> your domain -> Overview, right-hand side). 32 hex characters.
# Example: export TF_VAR_account_id=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d
export TF_VAR_account_id=

# Zone ID (same page, just above Account ID). 32 hex characters.
# Example: export TF_VAR_zone_id=9f8e7d6c5b4a39281706f5e4d3c2b1a0
export TF_VAR_zone_id=

# The domain you bought, without "www" or "https://".
# Example: export TF_VAR_domain=example.com
export TF_VAR_domain=

# Subdomain for your home machine. You will SSH to <machine_name>.<domain>.
# Example: export TF_VAR_machine_name=homebox    (-> homebox.example.com)
export TF_VAR_machine_name=

# Emails allowed to log in, comma-separated, no spaces or quotes.
# Example: export TF_VAR_allowed_emails=you@example.com,friend@example.com
export TF_VAR_allowed_emails=
